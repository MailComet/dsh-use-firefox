{
  "manifest_version": 3,
  "name": "DSH Use Firefox",
  "version": "0.4.3",
  "description": "Let DeepSeek Harness operate your real Firefox through the DSH Use Firefox host plugin.",
  "browser_specific_settings": {
    "gecko": {
      "id": "dsh-use-firefox@sxyz.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "alarms",
    "activeTab"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "ws://127.0.0.1/*",
    "ws://localhost/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "DSH Use Firefox",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "start-annotation": {
      "suggested_key": {
        "default": "Ctrl+Alt+A",
        "mac": "MacCtrl+Alt+A"
      },
      "description": "Start a DSH annotation on the active page"
    }
  }
}
